# Postgres connection string (Neon). For production on Vercel, use Neon's
# pooled ("-pooler") connection string here; migrations need the direct one.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Public site origin, used to build absolute canonical/OG/JSON-LD URLs in metadata.
NEXT_PUBLIC_SITE_URL=https://www.utslovakia.sk

# Cloudflare R2 (S3-compatible) storage for Payload media uploads.
# Bucket name in R2.
S3_BUCKET=your-bucket-name
# R2 account-scoped S3 API endpoint, e.g. https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
# Public hostname of the bucket (r2.dev URL like pub-xxxx.r2.dev, or a custom domain such as
# media.example.com) — NOT the S3 API endpoint above. When set, media URLs point straight at it
# (fast, no serverless hop) and next.config.ts allows next/image to optimize from it. It must
# resolve and be publicly readable, or every image breaks. Leave empty to serve via
# /api/media/file/** instead.
S3_PUBLIC_HOSTNAME=pub-xxxx.r2.dev
